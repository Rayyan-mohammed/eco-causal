# Copy this into Streamlit Community Cloud's "Secrets" box for this app
# (App settings -> Secrets), or save it locally as .streamlit/secrets.toml
# for local testing of the secrets path (this exact filename is gitignored).
#
# Same keys as .env — TOML format instead of KEY=value.

GEMINI_API_KEY_1 = "your-key-1"
GEMINI_API_KEY_2 = "your-key-2"
GEMINI_API_KEY_3 = "your-key-3"
GEMINI_API_KEY_4 = "your-key-4"
GEMINI_API_KEY_5 = "your-key-5"
GEMINI_API_KEY_6 = "your-key-6"
GEMINI_API_KEY_7 = "your-key-7"
ROOTCAUSE_MODEL = "gemini-3.1-flash-lite"
