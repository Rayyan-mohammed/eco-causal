    "id": "s1",
    "domain": "soil_health",
    "scenario_text": "I farm monoculture wheat on a semi-arid plot with very low soil organic carbon and biodiversity is declining. What should I do?",
    "known_variables": {
      "rainfall_level": 280,
      "soil_organic_carbon": 0.4,
      "land_use": "monoculture wheat"
    },
    "claims": [
      {
        "chain": [
          [
            "cover_crop_adoption",
            "soil_organic_carbon"
          ],
          [
            "soil_organic_carbon",
            "soil_microbial_diversity"
          ]
        ],
        "expected": "downgraded",
        "reason": "cover_crop_adoption -> soil_organic_carbon requires rainfall >= 400mm; at 280mm (semi-arid) this fails."
      },
      {
        "chain": [
          [
            "agroforestry_adoption",
            "soil_moisture_retention"
          ]
        ],
        "expected": "accepted",
        "reason": "280mm satisfies the <=1000mm condition for this edge."
      },
      {
        "chain": [
          [
            "soil_organic_carbon",
            "soil_microbial_diversity"
          ],
          [
            "soil_microbial_diversity",
            "soil_structure"
          ]
        ],
        "expected": "accepted",
        "reason": "Both edges are unconditional."
      }
    ]
  },
