GEMINI_API_KEY=your-free-gemini-api-key-here
ROOTCAUSE_MODEL=gemini-3.1-flash-lite

# Optional: add more free-tier accounts' keys to round-robin across them for
# higher effective throughput. Numbered sequentially, no gaps:
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...

# Optional: how many times the pipeline retries a rejected draft before showing
# it to the user (default 1 — fast, avoids timing out on a slow host). The
# eval harness raises this to 3 automatically for --live runs, where latency
# isn't a constraint the way a live web request is.
# ROOTCAUSE_MAX_REGENERATIONS=1
